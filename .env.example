# OpenCode Buddy local provider keys.
#
# Copy this file to `.env` in the directory where you will run
# `opencode-buddy`, then fill only the providers you want to use:
#
#   cp .env.example .env
#   opencode-buddy keys validate --cwd .
#
# Never commit `.env`. This repository ignores `.env` by default.

# OpenCode Go (recommended for build/default/frontend when available)
OPENCODE_GO_API_KEY=

# DeepSeek direct API (recommended fallback for build/backend/default/deep)
DEEPSEEK_API_KEY=

# Moonshot/Kimi direct API (useful for frontend/default)
MOONSHOT_API_KEY=

# Anthropic native planner/model access
ANTHROPIC_API_KEY=

# Google Gemini native planner/model access (useful for audio/video/multimodal)
GEMINI_API_KEY=

# CommandCode or another OpenAI-compatible endpoint.
# COMMANDCODE_API_BASE is required when COMMANDCODE_API_KEY is set.
COMMANDCODE_API_KEY=
COMMANDCODE_API_BASE=

# Optional UI language override.
# Supported today: pt-BR, en-US
OPENCODE_BUDDY_LANG=pt-BR

# ChatGPT OAuth is not configured here.
# Use `opencode auth login` and choose ChatGPT when you want OAuth-backed models.
